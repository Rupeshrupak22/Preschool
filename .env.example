# ─── Database (TiDB Cloud / MySQL) ───────────────────────────────────
# Replace with your own TiDB Cloud endpoint (https://tidbcloud.com)
MYSQL_HOST=your-tidb-host.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your-username
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=preschool
MYSQL_SSL=true

# Note: DATABASE_URL takes precedence over individual MYSQL_* vars above.
# Use DATABASE_URL for TiDB Cloud. Use individual MYSQL_* vars for local MySQL.
DATABASE_URL="mysql://username:password@your-tidb-host.tidbcloud.com:4000/preschool"

# ─── JWT ─────────────────────────────────────────────────────────────
# IMPORTANT: JWT_SECRET must be the SAME across all 3 projects
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Payments (Razorpay) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# ─── Email (SMTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="ADYAPAN <hello@adyapan.com>"

# ─── AI (Optional) ──────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── ADMIN CREDENTIALS (for initial setup only) ─────────────────────
# These are used for the first admin login. After that, access keys are in the DB.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=sha256-hash-of-your-password
ADMIN_ACCESS_KEY=your-admin-access-key

# ─── TEACHER CREDENTIALS (for initial setup only) ───────────────────
TEACHER_EMAIL=teacher@your-domain.com
TEACHER_PASSWORD=sha256-hash-of-your-password
TEACHER_STAFF_KEY=your-teacher-staff-key

# ─── PRINCIPAL CREDENTIALS (for initial setup only) ─────────────────
PRINCIPAL_EMAIL=principal@your-domain.com
PRINCIPAL_PASSWORD=sha256-hash-of-your-password
PRINCIPAL_ACCESS_KEY=your-principal-access-key
