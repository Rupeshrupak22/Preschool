MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=preschool
MYSQL_SSL=false
# For TiDB Cloud, set MYSQL_SSL=true. If you download a CA certificate, either paste it in MYSQL_SSL_CA or set MYSQL_SSL_CA_PATH.
# MYSQL_SSL_CA_PATH=./ca.pem
# Or use DATABASE_URL=mysql://root:password@127.0.0.1:3306/preschool
JWT_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=replace-with-email-app-password
MAIL_FROM="ADYAPAN <your_email@example.com>"
OPENAI_API_KEY=replace-with-openai-api-key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Do not commit real admin, teacher, principal, database, SMTP, payment, or API secrets here.
# Put real values in .env.local locally and in Vercel Environment Variables for production.
