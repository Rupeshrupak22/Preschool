# TiDB Cloud / MySQL Connection (for Prisma)
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/preschool?sslaccept=strict"

# MySQL Connection (for raw queries - leaves, meetings)
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=username
MYSQL_PASSWORD=password
MYSQL_DATABASE=preschool
MYSQL_SSL=true

# JWT Config
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Server Config
PORT=4000
NODE_ENV=development
